<Window x:Class="KrnlAI.VisualStudio.ToolWindows.Backlog.BacklogCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Backlog Item" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource VsBrush.Window}"
        Foreground="{DynamicResource VsBrush.WindowText}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Title:" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="TitleBox" Grid.Row="0" Height="28" Margin="0,20,0,8"/>

        <TextBlock Grid.Row="1" Text="Description:" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="DescBox" Grid.Row="1" Height="60" TextWrapping="Wrap" Margin="0,20,0,8"
                 AcceptsReturn="True"/>

        <TextBlock Grid.Row="2" Text="Priority:" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox x:Name="PriorityCombo" Grid.Row="2" Margin="0,20,0,8" SelectedIndex="1">
            <ComboBoxItem>Low</ComboBoxItem>
            <ComboBoxItem IsSelected="True">Medium</ComboBoxItem>
            <ComboBoxItem>High</ComboBoxItem>
            <ComboBoxItem>Critical</ComboBoxItem>
        </ComboBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="80" Height="28" Margin="0,0,8,0" Click="OnCancel" IsCancel="True"/>
            <Button Content="Create" Width="80" Height="28" Click="OnCreate" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
