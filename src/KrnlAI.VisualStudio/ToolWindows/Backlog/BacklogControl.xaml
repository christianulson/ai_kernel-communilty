<UserControl x:Class="KrnlAI.VisualStudio.ToolWindows.Backlog.BacklogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource VsBrush.Window}"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="📋 Backlog" FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource VsBrush.CaptionText}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="CountText" Text="0 items"
                       Foreground="{DynamicResource VsBrush.GrayText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="Refresh" Width="60" Height="22" Click="OnRefresh" Margin="0,0,4,0"/>
                <Button x:Name="NewButton" Content="+ New" Width="60" Height="22" Click="OnNewItem"/>
            </StackPanel>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Background="{DynamicResource VsBrush.CommandBarOptionsBackground}"
                CornerRadius="4" Padding="6" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource VsBrush.CaptionText}"/>
                <ComboBox x:Name="StatusFilter" Width="110" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem IsSelected="True">All</ComboBoxItem>
                    <ComboBoxItem>Pending</ComboBoxItem>
                    <ComboBoxItem>InProgress</ComboBoxItem>
                    <ComboBoxItem>Review</ComboBoxItem>
                    <ComboBoxItem>Done</ComboBoxItem>
                    <ComboBoxItem>Cancelled</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="Priority:" VerticalAlignment="Center" Margin="16,0,6,0"
                           Foreground="{DynamicResource VsBrush.CaptionText}"/>
                <ComboBox x:Name="PriorityFilter" Width="90" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem IsSelected="True">All</ComboBoxItem>
                    <ComboBoxItem>Low</ComboBoxItem>
                    <ComboBoxItem>Medium</ComboBoxItem>
                    <ComboBoxItem>High</ComboBoxItem>
                    <ComboBoxItem>Critical</ComboBoxItem>
                </ComboBox>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource VsBrush.GrayText}"/>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionUnit="FullRow" AlternatingRowBackground="{DynamicResource VsBrush.CommandBarOptionsBackground}"
                  Background="{DynamicResource VsBrush.Window}"
                  BorderBrush="{DynamicResource VsBrush.ActiveBorder}" BorderThickness="1"
                  Foreground="{DynamicResource VsBrush.WindowText}" FontSize="12"
                  RowHeaderWidth="0" GridLinesVisibility="None">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource VsBrush.CommandBarOptionsBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource VsBrush.CaptionText}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Height" Value="26"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="MinHeight" Value="28"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80"/>
                <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="120"/>
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Actions -->
        <Border Grid.Row="3" Background="{DynamicResource VsBrush.ToolWindowBackground}"
                CornerRadius="4" Padding="6" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="MoveLeftButton" Content="◀ Move Left" Width="80" Height="22" Click="OnMoveLeft" Margin="0,0,4,0"/>
                <Button x:Name="MoveRightButton" Content="Move Right ▶" Width="90" Height="22" Click="OnMoveRight" Margin="0,0,4,0"/>
                <Button x:Name="DeleteButton" Content="Delete" Width="60" Height="22" Click="OnDelete" Margin="0,0,4,0"/>
                <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{DynamicResource VsBrush.GrayText}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
