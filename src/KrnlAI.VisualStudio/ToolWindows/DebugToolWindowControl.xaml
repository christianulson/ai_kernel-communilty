<UserControl x:Class="KrnlAI.VisualStudio.ToolWindows.DebugToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600"
             Background="{DynamicResource VsBrush.Window}">
    <TabControl Margin="4" BorderThickness="0"
                Background="{DynamicResource VsBrush.Window}">
        <!-- Operations Tab -->
        <TabItem Header="Operations" Background="{DynamicResource VsBrush.CommandBarOptionsBackground}"
                 Foreground="{DynamicResource VsBrush.CaptionText}">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🧠 Debug Trace" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource VsBrush.CaptionText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="CountText" Text="0 operations"
                               Foreground="{DynamicResource VsBrush.GrayText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="ClearButton" Content="Clear" Width="50" Height="22" Click="OnClear" Margin="0,0,4,0" />
                        <Button x:Name="RefreshButton" Content="Refresh" Width="50" Height="22" Click="OnRefresh" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource VsBrush.ToolWindowBackground}"
                        CornerRadius="4" Padding="6" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="SummaryTotal" Text="Total: 0"
                                   Margin="0,0,12,0" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" x:Name="SummarySuccess" Text="✅ 0"
                                   Margin="0,0,12,0" Foreground="#22c55e" />
                        <TextBlock Grid.Column="2" x:Name="SummaryFailed" Text="❌ 0"
                                   Margin="0,0,12,0" Foreground="#ef4444" />
                        <TextBlock Grid.Column="3" x:Name="SummaryAvgDuration" Text="Ø 0ms"
                                   Margin="0,0,12,0" Foreground="{DynamicResource VsBrush.GrayText}" />
                        <TextBlock Grid.Column="4" x:Name="SummarySlowest" Text=""
                                   Foreground="{DynamicResource VsBrush.GrayText}" FontSize="11" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="OperationList" BorderThickness="0" Focusable="False"
                                  Foreground="{DynamicResource VsBrush.WindowText}" FontFamily="Consolas" FontSize="12" />
                </ScrollViewer>

                <TextBlock Grid.Row="3" x:Name="StatusText" Text="Ready"
                           Foreground="{DynamicResource VsBrush.GrayText}" Margin="0,4,0,0" />
            </Grid>
        </TabItem>

        <!-- Loops Tab -->
        <TabItem Header="Loops" Background="{DynamicResource VsBrush.CommandBarOptionsBackground}"
                 Foreground="{DynamicResource VsBrush.CaptionText}">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔄 TDD Loops" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource VsBrush.CaptionText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="LoopCountText" Text="0 items"
                               Foreground="{DynamicResource VsBrush.GrayText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Button Grid.Column="2" x:Name="LoopRefreshButton" Content="Refresh" Width="60" Height="22" Click="OnLoopRefresh" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LoopList" BorderThickness="0" Focusable="False"
                                  Foreground="{DynamicResource VsBrush.WindowText}" FontSize="12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="8" CornerRadius="4"
                                        BorderBrush="{DynamicResource VsBrush.ActiveBorder}" BorderThickness="1"
                                        Background="{DynamicResource VsBrush.ToolWindowBackground}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Id}" FontWeight="Bold"
                                                       Foreground="{DynamicResource VsBrush.CaptionText}" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource VsBrush.CaptionText}"/>
                                            <Border Grid.Column="2" CornerRadius="4" Padding="4,1"
                                                    Background="{Binding StatusColor}">
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#fff"/>
                                            </Border>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Steps}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="11"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                                   FontSize="11" Foreground="{DynamicResource VsBrush.GrayText}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                                   FontSize="11" Foreground="{DynamicResource VsBrush.GrayText}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="2" x:Name="LoopStatusText" Text="Ready"
                           Foreground="{DynamicResource VsBrush.GrayText}" Margin="0,4,0,0" />
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
