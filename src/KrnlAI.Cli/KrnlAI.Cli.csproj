<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn)</NoWarn>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>krnlai</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <PackageId>KrnlAI.Cli</PackageId>
    <Description>Krnl-AI CLI - Developer Interface for scaffolding and managing cognitive agents</Description>
    <Authors>Krnl-AI</Authors>
  </PropertyGroup>
  <ItemGroup Condition="Exists('..\..\..\src\KrnlAI.Core\KrnlAI.Core.csproj')">
    <ProjectReference Include="..\..\..\src\LLMGateway.Core\LLMGateway.Core.csproj" />
    <ProjectReference Include="..\..\..\src\KrnlAI.Embedded\KrnlAI.Embedded.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\..\src\KrnlAI.Core\KrnlAI.Core.csproj')">
    <PackageReference Include="LLMGateway.Core" Version="1.0.0" />
    <PackageReference Include="KrnlAI.Embedded" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
    <PackageReference Include="Spectre.Console" Version="0.57.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Templates\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KrnlAI.Cli.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.Playwright" ExcludeAssets="contentFiles" />
  </ItemGroup>
  <ItemGroup>
    <Content Update=".playwright\**" Pack="false" />
    <Content Update="playwright.ps1" Pack="false" />
  </ItemGroup>
  <!-- Playwright installer scripts are not packable inside a dotnet tool (NU5111).
       Remove them from the publish output before NuGet collects the package files. -->
  <Target Name="ExcludePlaywrightScriptsFromToolPack" AfterTargets="Publish" BeforeTargets="_GetPackageFiles;Pack">
    <ItemGroup>
      <_PlaywrightScriptsToRemove Include="$(PublishDir).playwright\**\*.ps1" />
      <_PlaywrightScriptsToRemove Include="$(PublishDir)playwright.ps1" />
    </ItemGroup>
    <Delete Files="@(_PlaywrightScriptsToRemove)" ContinueOnError="true" />
  </Target>
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
</Project>
