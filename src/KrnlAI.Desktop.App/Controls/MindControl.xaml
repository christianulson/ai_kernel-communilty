<UserControl x:Class="KrnlAI.Desktop.App.Controls.MindControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="#223C82F6" BorderThickness="1" CornerRadius="16" Padding="18">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🧠 Mente" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="O que o cérebro está pensando agora" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Atualizar" Command="{Binding RefreshCommand}"
                        Padding="10,4" FontSize="12" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        AutomationProperties.Name="Atualizar mente"/>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tom emocional" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding EmotionalTone}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Valência / Ativação" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                        <Run Text="{Binding Valence, StringFormat={}{0:F2}, Mode=OneWay}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding Arousal, StringFormat={}{0:F2}, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Procedimentos aprendidos" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding LearnedProcedures}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Próximos compromissos" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding Agenda}" Margin="0,0,0,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Notas abertas" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding Notes}" Margin="0,0,0,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Metas autônomas" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding Goals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Crescimento" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
            <TextBlock Text="{Binding GrowthSummary}" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <TextBlock Text="Foco de aprendizado" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
            <TextBlock Text="{Binding LearningFocus}" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </StackPanel>
    </Border>
</UserControl>
