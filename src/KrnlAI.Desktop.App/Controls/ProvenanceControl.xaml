<UserControl x:Class="KrnlAI.Desktop.App.Controls.ProvenanceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:KrnlAI.Desktop.App.Converters">
    <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{loc:Loc provenance_title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="{loc:Loc provenance_subtitle}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding ProvenanceVM.SearchEntityId, UpdateSourceTrigger=PropertyChanged}" Padding="12,10"
                         Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"/>
                <Button Grid.Column="1" Command="{Binding ProvenanceVM.LoadCommand}" Style="{StaticResource SmallButton}" Padding="16,10" Margin="8,0,0,0">
                    <TextBlock Text="{loc:Loc provenance_search}"/>
                </Button>
            </Grid>

            <Border Background="{DynamicResource PanelBrush}" CornerRadius="24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="24"
                    Visibility="{Binding ProvenanceVM.HasData, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding ProvenanceVM.Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding EntityType}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="12" Padding="8,4"
                                                    Background="{Binding IsIntact, Converter={StaticResource BoolToBrushConverter}}">
                                                <TextBlock Text="{Binding IsIntact, StringFormat={}{0}}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding RecordedAt, StringFormat={}{0:g}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Command="{Binding ProvenanceVM.VerifyCommand}" CommandParameter="{Binding ProvenanceVM.SearchEntityId}"
                            Style="{StaticResource SmallButton}" Padding="16,10" Margin="0,8,0,0">
                        <TextBlock Text="{loc:Loc provenance_verify}"/>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
